      "entry_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/07_Skyfin_Einsteigen.png",
      "seat_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/08_Skyfin_Anschnallen.png",
      "scene_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/02_Hafen_Flugzeug_U_Boot_Szenen/03_Skyfin_Boarding.png",
      "boarding_camera": "cam_board_air",
      "control_camera": "cam_vehicle_air",
      "required_sockets": [
