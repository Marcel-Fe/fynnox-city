        "foot_cockpit_step",
        "belt_anchor_l",
        "belt_anchor_r"
      ],
      "moving_parts": ["cockpit_door", "seat_belt", "propeller", "rudder", "ailerons"],
      "animation_ids": [
        "fox_skyfin_climb_step",
        "fox_skyfin_enter_cockpit",
        "fox_skyfin_buckle",
        "fox_skyfin_flight_idle",
        "fox_skyfin_unbuckle",
        "fox_skyfin_exit"
      ],
      "entry_conditions": ["vehicle_docked_or_parked", "propeller_stopped", "cockpit_clear"]
    },
    {
      "id": "vehicle_bluefin_scout",
      "type": "electric_research_submarine",
      "turnaround": "03_Bildreferenzen/24_Bluefin_Scout_U_Boot/00_Mehransichten.png",
      "entry_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/09_U_Boot_Hatch_Einstieg.png",
      "scene_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/02_Hafen_Flugzeug_U_Boot_Szenen/04_Bluefin_Scout_Einstieg.png",
      "boarding_camera": "cam_board_water",
