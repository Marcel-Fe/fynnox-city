      "entry_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/05_Scooter_Aufsteigen.png",
      "exit_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/06_Scooter_Absteigen.png",
      "boarding_camera": "cam_board_land",
      "control_camera": "cam_vehicle_land",
      "required_sockets": [
        "entry_driver",
        "exit_driver_primary",
        "seat_driver",
