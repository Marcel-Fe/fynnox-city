      "entry_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/04_Wassertaxi_Borden.png",
      "scene_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/02_Hafen_Flugzeug_U_Boot_Szenen/02_Wassertaxi_Boarding.png",
      "boarding_camera": "cam_board_water",
