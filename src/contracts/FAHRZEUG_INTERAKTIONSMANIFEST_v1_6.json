{
  "schema_version": "1.0",
  "package_version": "1.6",
  "project": "Fynnox City",
  "purpose": "engine_agnostic_vehicle_boarding_contract",
  "units": {
    "world_unit_meters": 1.0,
    "up_axis": "+Y",
    "model_forward_axis": "-Z"
  },
  "global_contract": {
    "request_action": "action_enter_vehicle",
    "exit_action": "action_exit_vehicle",
    "source_context": "ctx_on_foot",
    "vehicle_context": "ctx_vehicle",
    "entry_state_sequence": [
      "entry_requested",
      "entry_validated",
      "align_to_entry",
      "camera_boarding_blend",
      "open_entry_part",
      "attach_contact_ik",
      "root_motion_to_seat",
      "bind_to_seat",
      "switch_input_context",
      "vehicle_control"
    ],
    "exit_state_sequence": [
      "exit_requested",
      "find_safe_exit",
      "stop_vehicle_control",
      "open_entry_part",
      "root_motion_to_exit",
      "unbind_from_seat",
      "switch_input_context",
      "camera_on_foot_blend",
      "on_foot"
    ],
    "safe_exit_policy": {
      "validate_with_capsule_sweep": true,
      "prefer_primary_exit": true,
      "use_alternate_exit_when_blocked": true,
      "deny_exit_when_all_anchors_blocked": true,
      "teleport_player_out": false
    },
    "save_atomic_fields": [
      "player_state",
      "vehicle_id",
      "seat_id",
      "vehicle_transform",
      "door_or_hatch_state",
      "active_input_context",
      "camera_profile"
    ]
  },
  "camera_profiles": [
    {"id": "cam_board_land", "blend_seconds_range": [0.35, 0.6], "reduced_motion_supported": true},
    {"id": "cam_board_water", "blend_seconds_range": [0.45, 0.75], "reduced_motion_supported": true},
    {"id": "cam_board_air", "blend_seconds_range": [0.5, 0.8], "reduced_motion_supported": true},
    {"id": "cam_vehicle_land", "collision_avoidance": true, "speed_based_distance": true},
    {"id": "cam_vehicle_water", "collision_avoidance": true, "horizon_damping": true},
    {"id": "cam_vehicle_air", "collision_avoidance": true, "roll_compensation": true}
  ],
  "vehicles": [
    {
      "id": "vehicle_city_spark",
      "type": "electric_buggy",
      "turnaround": "03_Bildreferenzen/09_Fahrzeuge/01_City_Spark_Elektrobuggy/00_Mehransichten.png",
      "entry_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/02_Buggy_Einsteigen.png",
      "exit_reference": "03_Bildreferenzen/26_Open_City_Abenteuer/01_Fahrzeug_Einstieg_Ausstieg/03_Buggy_Aussteigen.png",
      "boarding_camera": "cam_board_land",
      "control_camera": "cam_vehicle_land",
      "required_sockets": [
        "entry_driver",
        "exit_driver_primary",
        "exit_driver_alt",
        "seat_driver",
        "look_driver",
        "camera_boarding",
        "camera_drive",
        "hand_door",
        "hand_wheel_l",
        "hand_wheel_r",
        "foot_pedal_l",
        "foot_pedal_r"
      ],
      "moving_parts": ["door_driver", "steering_wheel", "wheels", "suspension"],
      "animation_ids": [
        "fox_buggy_open_door",
        "fox_buggy_enter",
        "fox_buggy_exit",
        "fox_buggy_close_door",
        "fox_buggy_drive_idle",
        "fox_buggy_steer_left",
        "fox_buggy_steer_right",
        "fox_buggy_brake"
      ],
      "entry_requires_stationary": true
    },
    {
      "id": "vehicle_pawglide",
