      ],
      "entry_conditions": ["vehicle_docked", "pressure_equalized", "hatch_unlocked"],
      "weapons": false
    }
  ],
  "implementation_questions": [
    {
      "id": "engine_and_version",
      "question_de": "Welche Engine und genaue Version verwendet das Projekt?",
      "required_before": "socket_and_animator_setup"
    },
    {
      "id": "character_rig_source",
      "question_de": "Wo liegt das aktuelle Fynnox-Rig beziehungsweise das editierbare Modellquellformat?",
      "required_before": "ik_and_root_motion"
    },
    {
      "id": "vehicle_source_formats",
      "question_de": "In welchem editierbaren Quellformat werden die Fahrzeugmodelle erstellt?",
      "required_before": "moving_part_pivots"
    },
    {
      "id": "input_target",
      "question_de": "Soll der erste Test mit Touch, Gamepad, Tastatur oder allen drei Eingaben erfolgen?",
      "required_before": "interaction_test"
    },
    {
      "id": "savegame_strategy",
      "question_de": "Welches Savegame-Verfahren ist im vorhandenen Projekt bereits aktiv?",
      "required_before": "vehicle_state_persistence"
    }
  ]
}
